{
  "$schema": "https://raw.githubusercontent.com/antares-sql/themes/main/schema/theme.schema.json",
  "schemaVersion": 1,
  "id": "merbivore",
  "name": "Merbivore",
  "appearance": "dark",
  "author": "Antares SQL",
  "description": "Merbivore for Antares: the code editor theme ported from the Ace editor, with a matching interface.",
  "license": "BSD-3-Clause",
  "tags": [
    "ace"
  ],
  "colors": {
    "bg-app": "#161616",
    "bg-panel": "#202020",
    "bg-panel-hover": "#333232",
    "bg-surface": "#161616",
    "bg-raised": "#2b2a2a",
    "bg-titlebar": "#2b2a2a",
    "bg-settingbar": "#111111",
    "settingbar-text": "#ffffff",
    "bg-tabbar": "#2b2a2a",
    "bg-card": "#272626",
    "bg-hover": "rgb(230 225 220 / 6%)",
    "bg-hover-strong": "rgb(230 225 220 / 12%)",
    "bg-overlay": "rgb(255 255 255 / 12%)",
    "text": "#e6e1dc",
    "text-muted": "#a8a4a1",
    "success": "#32b643",
    "warning": "#e0a40c",
    "error": "#de3b28",
    "border": "#444342",
    "border-subtle": "#2b2a2a",
    "separator": "#403f3e",
    "divider": "rgb(230 225 220 / 12%)",
    "shadow-color": "#000000",
    "input-bg": "#222222",
    "input-bg-readonly": "#161616",
    "input-bg-disabled": "#1c1c1c",
    "menu-hover-bg": "#222222",
    "menu-hover-text": "accent",
    "modal-header-bg": "#2b2a2a",
    "modal-header-text": "#e6e1dc",
    "context-bg": "#202020",
    "context-text": "#e6e1dc",
    "context-hover": "rgb(230 225 220 / 10%)",
    "context-border": "#403f3e",
    "tooltip-bg": "rgb(48 55 66 / 95%)",
    "tooltip-text": "#fff",
    "btn-dark-bg": "#403f3e",
    "btn-dark-bg-hover": "#2b2a2a",
    "btn-gray-bg": "#2b2a2a",
    "btn-gray-bg-hover": "#1e1e1e",
    "btn-text": "#ffffff",
    "code-bg": "#0e0e0e",
    "code-border": "#403f3e",
    "code-text": "#8dff0a",
    "scrollbar-track": "#272626",
    "scrollbar-thumb": "rgb(230 225 220 / 35%)",
    "scrollbar-thumb-hover": "rgb(230 225 220 / 70%)",
    "grid-header-bg": "#161616",
    "grid-header-border": "#202020",
    "grid-row-bg": "#1e1e1e",
    "grid-border": "#161616",
    "grid-cell-focus": "#888683",
    "grid-cell-focus-bg": "rgb(0 0 0 / 30%)",
    "table-border": "#353434",
    "table-row-alt": "#1c1c1c",
    "table-row-hover": "#272626",
    "table-row-active": "#202020",
    "table-row-selected": "rgb(230 225 220 / 15%)",
    "diagram-dot": "rgb(230 225 220 / 10%)",
    "diagram-table-bg": "#202020",
    "diagram-table-border": "#545351",
    "diagram-header-bg": "#333232",
    "diagram-row-linked": "rgb(230 225 220 / 4%)",
    "diagram-row-hover": "rgb(230 225 220 / 8%)",
    "diagram-relation": "#7e7c79",
    "type-string": "#8dff0a",
    "type-number": "#58c554",
    "type-date": "#fc6f09",
    "type-bit": "#fdc251",
    "type-blob": "#fc6f09",
    "type-array": "yellowgreen",
    "type-enum": "#fc6f09",
    "type-unknown": "#ad2ea4",
    "size-chart-fill": "#8dff0a",
    "size-chart-track": "#4a4948"
  },
  "editor": {
    "colors": {
      "background": "#161616",
      "foreground": "#E6E1DC",
      "cursor": "#FFFFFF",
      "selection": "#454545",
      "gutterBackground": "#202020",
      "gutterForeground": "#E6E1DC",
      "gutterActiveLine": "#333435",
      "activeLine": "rgba(229, 236, 243, 0.14)",
      "matchingBracket": "#404040",
      "selectionMatch": "#454545",
      "invisible": "#404040"
    },
    "syntax": {
      "keyword": {
        "color": "#FC6F09"
      },
      "operator": {
        "color": "#FC6F09"
      },
      "type": {
        "color": "#FC6F09"
      },
      "builtin": {
        "color": "#FC6F09"
      },
      "number": {
        "color": "#58C554"
      },
      "atom": {
        "color": "#FDC251"
      },
      "string": {
        "color": "#8DFF0A"
      },
      "regexp": {
        "color": "#8DFF0A"
      },
      "comment": {
        "color": "#AD2EA4",
        "fontStyle": "italic"
      },
      "tag": {
        "color": "#FC6F09"
      },
      "attribute": {
        "color": "#FFFF89"
      },
      "attributeValue": {
        "color": "#8DFF0A"
      },
      "tagPunctuation": {
        "color": "#FC6F09"
      },
      "emphasis": {
        "color": "#8DFF0A"
      },
      "strong": {
        "color": "#8DFF0A"
      },
      "quote": {
        "color": "#8DFF0A"
      },
      "monospace": {
        "color": "#FC6F09"
      },
      "invalid": {
        "color": "#FFFFFF",
        "backgroundColor": "#990000"
      }
    }
  }
}
