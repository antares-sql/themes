{
  "$schema": "https://raw.githubusercontent.com/antares-sql/themes/main/schema/theme.schema.json",
  "schemaVersion": 1,
  "id": "high-contrast-light",
  "name": "High Contrast Light",
  "appearance": "light",
  "author": "Antares SQL",
  "description": "High Contrast Light: maximum contrast, thick borders, a strong focus ring and wide scrollbars, for low vision users. Pair it with a larger interface text size (Settings, Themes).",
  "license": "MIT",
  "tags": [
    "accessibility",
    "high-contrast"
  ],
  "colors": {
    "bg-app": "#ffffff",
    "bg-panel": "#ffffff",
    "bg-panel-hover": "#d9d9d9",
    "bg-surface": "#ffffff",
    "bg-raised": "#ffffff",
    "bg-titlebar": "#ffffff",
    "bg-settingbar": "#000000",
    "settingbar-text": "#ffffff",
    "bg-tabbar": "#ffffff",
    "bg-card": "#f2f2f2",
    "bg-hover": "rgb(0 0 0 / 12%)",
    "bg-hover-strong": "rgb(0 0 0 / 20%)",
    "bg-overlay": "rgb(0 0 0 / 60%)",
    "text": "#000000",
    "text-muted": "#1a1a1a",
    "text-placeholder": "#595959",
    "success": "#32b643",
    "warning": "#e0a40c",
    "error": "#de3b28",
    "border": "#000000",
    "border-subtle": "#404040",
    "separator": "#000000",
    "divider": "rgb(0 0 0 / 60%)",
    "shadow-color": "#000000",
    "input-bg": "#ffffff",
    "input-bg-readonly": "#ebebeb",
    "input-bg-disabled": "#bfbfbf",
    "menu-hover-bg": "#d9d9d9",
    "menu-hover-text": "#000000",
    "modal-header-bg": "#000000",
    "modal-header-text": "#ffffff",
    "context-bg": "#ffffff",
    "context-text": "#000000",
    "context-hover": "#d9d9d9",
    "context-border": "#000000",
    "tooltip-bg": "#000000",
    "tooltip-text": "#ffffff",
    "btn-dark-bg": "#262626",
    "btn-dark-bg-hover": "#000000",
    "btn-gray-bg": "#262626",
    "btn-gray-bg-hover": "#000000",
    "btn-text": "#ffffff",
    "code-bg": "#ffffff",
    "code-border": "#000000",
    "code-text": "#000000",
    "scrollbar-track": "#e6e6e6",
    "scrollbar-thumb": "#404040",
    "scrollbar-thumb-hover": "#000000",
    "grid-header-bg": "#d9d9d9",
    "grid-header-border": "#000000",
    "grid-row-bg": "#ffffff",
    "grid-border": "#7f7f7f",
    "grid-cell-focus": "#0000cc",
    "grid-cell-focus-bg": "#e6e6ff",
    "table-border": "#000000",
    "table-row-alt": "#f2f2f2",
    "table-row-hover": "#e0e0e0",
    "table-row-active": "#ebebeb",
    "table-row-selected": "#cccccc",
    "diagram-dot": "rgb(0 0 0 / 25%)",
    "diagram-table-bg": "#ffffff",
    "diagram-table-border": "#000000",
    "diagram-header-bg": "#d9d9d9",
    "diagram-row-linked": "rgb(0 0 204 / 12%)",
    "diagram-row-hover": "rgb(0 0 0 / 15%)",
    "diagram-relation": "#000000",
    "type-string": "#005c00",
    "type-number": "#00008b",
    "type-date": "#8b3a00",
    "type-bit": "#005f73",
    "type-blob": "#6a0080",
    "type-array": "#3b5d00",
    "type-enum": "#6b4c00",
    "type-unknown": "#404040",
    "size-chart-fill": "#0000cc",
    "size-chart-track": "#bfbfbf"
  },
  "shape": {
    "radius": "0.15rem",
    "radius-lg": "6px",
    "border-width": "2px",
    "border-width-lg": "3px",
    "grid-border-width": "2px",
    "focus-ring-width": "3px",
    "scrollbar-size": "16px",
    "focus-ring-color": "#0000cc"
  },
  "editor": {
    "colors": {
      "background": "#ffffff",
      "foreground": "#000000",
      "cursor": "#000000",
      "selection": "#b3d7ff",
      "gutterBackground": "#ffffff",
      "gutterForeground": "#000000",
      "gutterActiveLine": "#e0e0e0",
      "activeLine": "#f0f0f0",
      "matchingBracket": "#c0c0c0",
      "selectionMatch": "#d6d6ff",
      "invisible": "#7f7f7f"
    },
    "syntax": {
      "keyword": {
        "color": "#00008b",
        "fontWeight": "bold"
      },
      "operator": {
        "color": "#000000"
      },
      "type": {
        "color": "#005f73"
      },
      "builtin": {
        "color": "#6a0080"
      },
      "number": {
        "color": "#8b0000"
      },
      "atom": {
        "color": "#005f73"
      },
      "string": {
        "color": "#005c00"
      },
      "regexp": {
        "color": "#005c00"
      },
      "comment": {
        "color": "#404040",
        "fontStyle": "italic"
      },
      "variable": {
        "color": "#8b3a00"
      },
      "property": {
        "color": "#000000"
      },
      "punctuation": {
        "color": "#000000"
      },
      "tag": {
        "color": "#00008b"
      },
      "attribute": {
        "color": "#6a0080"
      },
      "attributeValue": {
        "color": "#005c00"
      },
      "invalid": {
        "color": "#a00000",
        "textDecoration": "underline"
      }
    }
  }
}
