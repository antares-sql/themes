{
  "$schema": "https://raw.githubusercontent.com/antares-sql/themes/main/schema/theme.schema.json",
  "schemaVersion": 1,
  "id": "chrome",
  "name": "Chrome",
  "appearance": "light",
  "author": "Antares SQL",
  "description": "Chrome for Antares: the code editor theme ported from the Ace editor, with a matching interface.",
  "license": "BSD-3-Clause",
  "tags": [
    "ace"
  ],
  "colors": {
    "bg-app": "#ffffff",
    "bg-panel": "#f7f7f7",
    "bg-panel-hover": "#dbdbdb",
    "bg-surface": "#ffffff",
    "bg-raised": "#ffffff",
    "bg-titlebar": "#f2f2f2",
    "bg-settingbar": "#383838",
    "settingbar-text": "#ffffff",
    "bg-tabbar": "#ffffff",
    "bg-card": "#ebebeb",
    "bg-hover": "rgb(0 0 0 / 6%)",
    "bg-hover-strong": "rgb(0 0 0 / 12%)",
    "bg-overlay": "rgb(0 0 0 / 60%)",
    "text": "#000000",
    "text-muted": "#4d4d4d",
    "success": "#32b643",
    "warning": "#e0a40c",
    "error": "#de3b28",
    "border": "#c7c7c7",
    "border-subtle": "#e6e6e6",
    "separator": "#cccccc",
    "divider": "rgb(0 0 0 / 12%)",
    "shadow-color": "#000000",
    "input-bg": "#fafafa",
    "input-bg-readonly": "#f5f5f5",
    "input-bg-disabled": "#b3b3b3",
    "menu-hover-bg": "#f0f0f0",
    "menu-hover-text": "accent",
    "modal-header-bg": "#383838",
    "modal-header-text": "#ffffff",
    "context-bg": "#ffffff",
    "context-text": "#000000",
    "context-hover": "rgb(0 0 0 / 10%)",
    "context-border": "#cccccc",
    "tooltip-bg": "rgb(48 55 66 / 95%)",
    "tooltip-text": "#fff",
    "btn-dark-bg": "#737373",
    "btn-dark-bg-hover": "#404040",
    "btn-gray-bg": "#404040",
    "btn-gray-bg-hover": "#262626",
    "btn-text": "#ffffff",
    "code-bg": "#f2f2f2",
    "code-border": "#cccccc",
    "code-text": "#1a1aa6",
    "scrollbar-track": "#ebebeb",
    "scrollbar-thumb": "rgb(0 0 0 / 35%)",
    "scrollbar-thumb-hover": "rgb(0 0 0 / 70%)",
    "grid-header-bg": "#e0e0e0",
    "grid-header-border": "transparent",
    "grid-row-bg": "#f5f5f5",
    "grid-border": "rgb(0 0 0 / 12%)",
    "grid-cell-focus": "#737373",
    "grid-cell-focus-bg": "#ffffff",
    "table-border": "#d9d9d9",
    "table-row-alt": "#f7f7f7",
    "table-row-hover": "#ebebeb",
    "table-row-active": "#f2f2f2",
    "table-row-selected": "rgb(0 0 0 / 15%)",
    "diagram-dot": "rgb(0 0 0 / 10%)",
    "diagram-table-bg": "#f2f2f2",
    "diagram-table-border": "#b3b3b3",
    "diagram-header-bg": "#dbdbdb",
    "diagram-row-linked": "rgb(0 0 0 / 4%)",
    "diagram-row-hover": "rgb(0 0 0 / 8%)",
    "diagram-relation": "#808080",
    "type-string": "#1a1aa6",
    "type-number": "#0000cd",
    "type-date": "#3c4c72",
    "type-bit": "#585cf6",
    "type-blob": "#930f80",
    "type-array": "#318495",
    "type-enum": "#930f80",
    "type-unknown": "#236e24",
    "size-chart-fill": "#1a1aa6",
    "size-chart-track": "#bfbfbf"
  },
  "editor": {
    "colors": {
      "background": "#FFFFFF",
      "foreground": "black",
      "cursor": "black",
      "selection": "rgb(181, 213, 255)",
      "gutterBackground": "#ebebeb",
      "gutterForeground": "#333",
      "gutterActiveLine": "#dcdcdc",
      "activeLine": "rgba(0, 0, 0, 0.07)",
      "matchingBracket": "rgb(192, 192, 192)",
      "selectionMatch": "rgb(200, 200, 250)",
      "invisible": "rgb(191, 191, 191)"
    },
    "syntax": {
      "keyword": {
        "color": "rgb(147, 15, 128)"
      },
      "operator": {
        "color": "rgb(104, 118, 135)"
      },
      "type": {
        "color": "rgb(147, 15, 128)"
      },
      "builtin": {
        "color": "rgb(60, 76, 114)"
      },
      "number": {
        "color": "rgb(0, 0, 205)"
      },
      "atom": {
        "color": "rgb(88, 92, 246)"
      },
      "string": {
        "color": "#1A1AA6"
      },
      "regexp": {
        "color": "#1A1AA6"
      },
      "comment": {
        "color": "#236e24"
      },
      "variable": {
        "color": "rgb(49, 132, 149)"
      },
      "property": {
        "color": "rgb(49, 132, 149)"
      },
      "tag": {
        "color": "rgb(147, 15, 128)"
      },
      "attribute": {
        "color": "#994409"
      },
      "attributeValue": {
        "color": "#1A1AA6"
      },
      "tagPunctuation": {
        "color": "rgb(147, 15, 128)"
      },
      "heading": {
        "color": "rgb(12, 7, 255)"
      },
      "emphasis": {
        "color": "#1A1AA6"
      },
      "strong": {
        "color": "#1A1AA6"
      },
      "list": {
        "color": "rgb(185, 6, 144)"
      },
      "quote": {
        "color": "#1A1AA6"
      },
      "monospace": {
        "color": "rgb(60, 76, 114)"
      },
      "meta": {
        "color": "rgb(104, 104, 91)"
      },
      "invalid": {
        "color": "white",
        "backgroundColor": "rgb(153, 0, 0)"
      }
    }
  }
}
